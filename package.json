{
  "name": "lucky-portal",
  "version": "0.1.0",
  "private": true,
  "description": "ላኪ · digital house draw portal (Telebirr C2B payments, automatic per-house draw)",
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev -p 3210",
    "build": "prisma generate && next build",
    "start": "next start -p 3210",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "verify": "node --env-file=.env scripts/verify-flow.mjs",
    "check:signer": "tsx scripts/check-signer.mjs",
    "check:gateway": "node --env-file=.env --import tsx scripts/dryrun-gateway.mjs",
    "i18n": "node scripts/gen-i18n.mjs",
    "setup": "prisma db push && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@types/nodemailer": "^8.0.2",
    "jose": "6.2.12",
    "next": "15.5.26",
    "nodemailer": "^7.0.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "prisma": "6.19.3",
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  }
}
