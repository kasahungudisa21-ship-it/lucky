# --- app ---
# Signed session cookie key; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=
APP_URL=http://localhost:3210

# --- database (SQLite for local development) ---
DATABASE_URL=file:./prisma/dev.db

# --- payment ---
# telebirr = call the real H5 C2B gateway. simulate = local development only, never enable in production.
PAYMENT_MODE=simulate
TELEBIRR_ENVIRONMENT=test
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=
TELEBIRR_PRIVATE_KEY=
TELEBIRR_PUBLIC_KEY=
# must be publicly reachable; localhost never receives gateway notifications
TELEBIRR_NOTIFY_URL=
TELEBIRR_REDIRECT_URL=
# merchant wallet that receives every payment, shown to participants as the payee
TELEBIRR_MERCHANT_PHONE=

# --- scheduled draws ---
# used as "Authorization: Bearer <value>" on POST /api/cron/draw
CRON_SECRET=
# the server runs the sweep, the gateway check and the alert queue by itself;
# set to false only when something else calls /api/cron/draw
RUN_SCHEDULER=true

# --- owner alerts ---
# a channel whose variables are not all filled in is simply never used; the
# activity log on /admin works with none of these set
ALERTS_ENABLED=true
# telegram: token from @BotFather and the numeric chat id of the owner's chat
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# the same bot may carry participant notices; /me can only offer the link once
# its username is known, and without it Telegram stays unoffered to participants
ALERT_TELEGRAM_BOT_USERNAME=
# email: any SMTP box allowed to write to ALERT_EMAIL_TO
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# sms: an HTTPS gateway that accepts {"to","message"} with a bearer key
ALERT_SMS_URL=
ALERT_SMS_API_KEY=
ALERT_SMS_TO=
ALERT_SMS_SENDER=

# --- participant notices ---
# the owner's gateway (ALERT_TELEGRAM_BOT_* and ALERT_SMS_*) is reused, but each
# notice is addressed to the person it belongs to: the chat id they linked on /me
# and the phone number they signed up with. ALERT_TELEGRAM_CHAT_ID and ALERT_SMS_TO
# are never used for a participant. With no gateway set the feed on /me still works.
